{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "AI Usage Tracker",
  "short_name": "AI Usage",
  "version": "0.2.4",
  "description": "Premium countdown timer + notifications for Claude and Codex usage limits. Always-visible widget, popup dashboard, and OS alerts.",
  "author": "SysAdminDoc",
  "homepage_url": "https://github.com/SysAdminDoc/AI-Usage_Tracker",
  "incognito": "split",

  "key": "",

  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "AI Usage Tracker",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },

  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ],
      "js": ["page-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/settings/usage*",
        "https://*.claude.ai/settings/usage*",
        "https://chatgpt.com/codex/cloud/settings/analytics*",
        "https://*.chatgpt.com/codex/cloud/settings/analytics*"
      ],
      "js": ["analytics-scraper.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "sidePanel"
  ],

  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*"
  ],

  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.github.com/*",
    "https://api.cursor.com/*",
    "https://monitoring.googleapis.com/*",
    "https://openrouter.ai/*",
    "http://*/*",
    "https://*/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["ui/theme.css", "ui/widget.css", "icons/*.png"],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ]
    }
  ]
}
